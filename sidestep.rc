// Explorer / Start menu / taskbar icon for Sidestep.exe
1 ICON "icons/app.ico"

// Version shown in File Properties > Details and Task Manager.
// VER_MAJOR/MINOR/PATCH and VER_STR come from Cargo.toml via build.rs.
1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Sidestep"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "Sidestep"
            VALUE "OriginalFilename", "Sidestep.exe"
            VALUE "ProductName", "Sidestep"
            VALUE "ProductVersion", VER_STR
            VALUE "LegalCopyright", "Licensed under GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
